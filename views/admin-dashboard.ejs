<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= branding?.brandName || coaching?.name || 'Edusync' %> - Admin Dashboard</title>
  <link rel="icon" type="image/png" href="/public/edusync-logo.png" />
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body class="dashboard-shell" style="<%= branding?.cssVars || '' %>">
  <div class="container wide">
    <div class="topbar card hero-card">
      <div class="brand-lockup">
        <% if (branding?.logoUrl) { %>
          <img src="<%= branding.logoUrl %>" alt="<%= branding.brandName %> logo" class="brand-logo" />
        <% } %>
        <div>
          <p class="eyebrow"><%= branding?.brandName || 'Coaching Management' %></p>
          <h1>Admin Dashboard</h1>
          <p class="muted">Welcome, <%= user.name %> | <strong><%= coaching?.name || user.coachingName || '-' %></strong> | Plan: <%= coaching?.plan_name || user.coachingPlan || '-' %></p>
          <div class="hero-chip-row">
            <span class="info-chip">Subscription <strong><%= coaching?.subscription_status || user.coachingSubscriptionStatus || '-' %></strong></span>
            <span class="info-chip">Storage <strong><%= (storageMode || 'local').toUpperCase() %></strong></span>
            <span class="info-chip">Batches <strong><%= batches.length %></strong></span>
            <span class="info-chip">Seats <strong><%= studentUsage.limit === null ? 'Unlimited' : `${studentUsage.count}/${studentUsage.limit}` %></strong></span>
          </div>
        </div>
      </div>
      <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button type="submit" class="btn secondary">Logout</button></form>
    </div>

    <% if (flash) { %>
      <div class="alert <%= flash.type %>"><%= flash.text %></div>
      <% if (activeSection === 'papers' && flash.details?.length) { %>
        <section class="card">
          <h3>Upload Details</h3>
          <div class="student-card-list">
            <% flash.details.forEach((item) => { %>
              <article class="student-card-compact">
                <div class="student-card-head">
                  <div>
                    <div class="student-roll-pill">File</div>
                    <h3><%= item.file %></h3>
                  </div>
                </div>
                <p class="muted"><%= item.reason %></p>
              </article>
            <% }) %>
          </div>
        </section>
      <% } %>
    <% } %>

    <% if (subscriptionState.accessBlocked) { %>
      <section class="card blocked-card">
        <h2><%= subscriptionState.blockedTitle %></h2>
        <p class="muted"><%= subscriptionState.blockedMessage %></p>
        <p class="muted">Portal access is restricted until the owner renews or reactivates the coaching subscription.</p>
      </section>
    <% } else { %>
      <section class="section-switcher card">
        <a class="sec-btn <%= activeSection === 'overview' ? 'active' : '' %>" href="/admin/dashboard?section=overview">Overview</a>
        <a class="sec-btn <%= activeSection === 'attendance' ? 'active' : '' %>" href="/admin/dashboard?section=attendance">Attendance</a>
        <a class="sec-btn <%= activeSection === 'students' ? 'active' : '' %>" href="/admin/dashboard?section=students">Student List</a>
        <a class="sec-btn <%= activeSection === 'fees' ? 'active' : '' %>" href="/admin/dashboard?section=fees">Fees Management</a>
        <a class="sec-btn <%= activeSection === 'papers' ? 'active' : '' %>" href="/admin/dashboard?section=papers">Test Papers</a>
        <a class="sec-btn <%= activeSection === 'notes' ? 'active' : '' %>" href="/admin/dashboard?section=notes">Batch Notes</a>
        <a class="sec-btn <%= activeSection === 'settings' ? 'active' : '' %>" href="/admin/dashboard?section=settings">Settings</a>
      </section>
    <% } %>

    <% if (subscriptionNotice) { %>
      <div class="alert warning"><%= subscriptionNotice %></div>
    <% } %>

    <% if (activeSection === 'overview') { %>
      <section class="stats-grid">
        <div class="stat-card"><p>Total Students</p><h3><%= stats.totalStudents %></h3></div>
        <div class="stat-card"><p>Total Papers</p><h3><%= stats.totalPapers %></h3></div>
        <div class="stat-card"><p>Pending/Overdue Fees</p><h3><%= stats.pendingFees %></h3></div>
        <div class="stat-card"><p>Absent Entries</p><h3><%= stats.absentEntries %></h3></div>
        <div class="stat-card"><p>Batch Notes</p><h3><%= stats.notesCount %></h3></div>
        <div class="stat-card"><p>Active Upload Windows</p><h3><%= stats.activeAnswerRequests %></h3></div>
        <div class="stat-card"><p>File Storage</p><h3><%= (storageMode || 'local').toUpperCase() %></h3></div>
        <div class="stat-card"><p>Student Limit</p><h3><%= studentUsage.limit === null ? 'Unlimited' : `${studentUsage.count}/${studentUsage.limit}` %></h3></div>
      </section>

      <section class="grid two">
        <div class="card">
          <h2>Quick Access</h2>
          <p class="muted">Use the top buttons to open Attendance, Student List, Fees Management, Papers, and Batch Notes.</p>
          <% if (studentUsage.limit !== null) { %>
            <p class="muted">Remaining student seats on this plan: <strong><%= studentUsage.remaining %></strong></p>
          <% } %>
          <p class="muted">The overview below now shows student contacts, uploaded papers, progress snapshot, and the 24-hour answer upload tracker.</p>
        </div>

        <div class="card">
          <h2>Announce Answer Upload</h2>
          <p class="muted">Create a 24-hour upload window. Students in that batch can upload their answer paper from their dashboard.</p>
          <form method="post" action="/admin/answer-requests" data-single-submit>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Title</label>
            <input type="text" name="title" placeholder="Physics Test 5 Answer Upload" required />

            <label>Batch</label>
            <select name="batchId" required>
              <option value="">Select batch</option>
              <% batches.forEach((batch) => { %>
                <option value="<%= batch.id %>"><%= batch.name %></option>
              <% }) %>
            </select>

            <label>Start Time</label>
            <input type="datetime-local" name="startsAt" value="<%= defaultAnswerRequestStart %>" required />

            <label>Description (optional)</label>
            <textarea name="description" rows="3" placeholder="Upload today's handwritten answer paper."></textarea>

            <button type="submit" class="btn" <%= batches.length ? '' : 'disabled' %>>Create 24 Hour Window</button>
          </form>
          <% if (!batches.length) { %>
            <p class="muted">Create a custom batch first, then you can announce upload windows for it.</p>
          <% } %>
        </div>
      </section>

      <section class="card">
        <h2>Student Overview</h2>
        <p class="muted">Admin can open a full student dashboard view, see uploaded papers, progress, contact details, and latest upload activity.</p>
        <table>
          <tr><th>Roll</th><th>Name</th><th>Batch</th><th>Phone</th><th>Email</th><th>Papers</th><th>Latest Score</th><th>Last Upload</th><th>Dashboard</th></tr>
          <% overviewStudents.forEach((student) => { %>
            <tr>
              <td><%= student.roll_no %></td>
              <td><%= student.name %></td>
              <td><%= student.batch_name || ((student.standard || student.course) ? `${student.standard || ''}${student.standard && student.course ? ' - ' : ''}${student.course ? student.course.toUpperCase() : ''}` : '-') %></td>
              <td><%= student.contact_phone || '-' %></td>
              <td><%= student.email || '-' %></td>
              <td><%= student.paperCount %></td>
              <td>
                <% if (student.latestPercent !== null) { %>
                  <%= student.latestPercent %>%
                  <div class="tiny-note"><%= student.latestMarkedLabel || '-' %></div>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td><%= student.lastUpload || '-' %></td>
              <td><a href="/admin/students/<%= student.id %>/overview">View Dashboard</a></td>
            </tr>
          <% }) %>
        </table>
      </section>

      <section class="card">
        <h2>24 Hour Upload Tracker</h2>
        <% if (!answerRequestSummaries.length) { %>
          <p class="muted">No answer upload windows created yet.</p>
        <% } %>

        <% answerRequestSummaries.forEach((request) => { %>
          <div class="tracker-card">
            <div class="tracker-head">
              <div>
                <h3><%= request.title %></h3>
                <p class="muted"><%= request.batch_name || ((request.standard || request.course) ? `${request.standard || ''}${request.standard && request.course ? ' - ' : ''}${request.course ? request.course.toUpperCase() : ''}` : '-') %></p>
                <% if (request.description) { %>
                  <p class="muted"><%= request.description %></p>
                <% } %>
              </div>
              <div class="tracker-meta">
                <span class="status <%= request.state.isActive ? 'paid' : request.state.isUpcoming ? 'pending' : 'overdue' %>"><%= request.state.phase %></span>
                <div class="tiny-note">Start: <%= request.state.startsAtLabel %></div>
                <div class="tiny-note">End: <%= request.state.endsAtLabel %></div>
              </div>
            </div>

            <div class="stats-grid compact-grid">
              <div class="stat-card"><p>Total Students</p><h3><%= request.totalStudents %></h3></div>
              <div class="stat-card"><p>Uploaded</p><h3><%= request.uploadedCount %></h3></div>
              <div class="stat-card"><p>Pending</p><h3><%= request.pendingCount %></h3></div>
              <div class="stat-card"><p>Time Left</p><h3><%= request.state.isActive ? `${request.state.remainingHours} hrs` : '-' %></h3></div>
            </div>

            <div class="tracker-filter-row">
              <label for="trackerFilter-<%= request.id %>">Show</label>
              <select id="trackerFilter-<%= request.id %>" class="tracker-filter" data-tracker-id="<%= request.id %>">
                <option value="uploaded">Students who submit</option>
                <option value="pending">Students who don't submit</option>
              </select>
            </div>

            <div class="card embedded-card tracker-panel active" data-tracker-panel="<%= request.id %>" data-tracker-mode="uploaded">
              <h3>Students who submit</h3>
              <% if (!request.uploadedStudents.length) { %>
                <p class="muted">No student has uploaded yet.</p>
              <% } %>
              <table>
                <tr><th>Status</th><th>Roll</th><th>Name</th><th>Uploaded At</th><th>Actions</th></tr>
                <% request.uploadedStudents.forEach((student) => { %>
                  <tr>
                    <td>✅</td>
                    <td><%= student.roll_no %></td>
                    <td><%= student.name %></td>
                    <td><%= student.submission.upload_date %></td>
                    <td>
                      <a href="/papers/<%= student.submission.id %>/view" target="_blank" rel="noopener">Open</a>
                      <form method="post" action="/papers/<%= student.submission.id %>/delete" style="display:inline-block" onsubmit="return confirm('Delete this uploaded paper?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <input type="hidden" name="redirectTo" value="/admin/dashboard?section=overview" />
                        <button type="submit" class="btn danger compact">Delete</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </table>
            </div>

            <div class="card embedded-card tracker-panel" data-tracker-panel="<%= request.id %>" data-tracker-mode="pending">
              <h3>Students who don't submit</h3>
              <% if (!request.pendingStudents.length) { %>
                <p class="muted">All students in this batch have uploaded.</p>
              <% } %>
              <table>
                <tr><th>Roll</th><th>Name</th><th>Contact</th><th>Email</th></tr>
                <% request.pendingStudents.forEach((student) => { %>
                  <tr>
                    <td><%= student.roll_no %></td>
                    <td><%= student.name %></td>
                    <td><%= student.contact_phone || '-' %></td>
                    <td><%= student.email || '-' %></td>
                  </tr>
                <% }) %>
              </table>
            </div>
          </div>
        <% }) %>
      </section>
    <% } %>

    <% if (!subscriptionState.accessBlocked && activeSection === 'students') { %>
      <section class="card">
        <h2>Search Student</h2>
        <form method="get" action="/admin/search-student" class="inline-controls">
          <label for="student-search-roll">Roll Number</label>
          <input id="student-search-roll" type="text" name="roll" value="<%= studentSearch?.query || '' %>" placeholder="Enter Roll Number" />
          <button type="submit" class="btn">Search</button>
          <% if (studentSearch?.query) { %>
            <a href="/admin/dashboard?section=students" class="btn secondary">Clear</a>
          <% } %>
        </form>
        <p class="muted">Search by exact roll number, partial roll, student name, or contact number.</p>
      </section>

      <% if (studentSearch?.query) { %>
        <section class="card">
          <h2>Search Results</h2>
          <% if (studentSearch.totalMatches) { %>
            <p class="muted">Showing <strong><%= studentSearch.results.length %></strong> result(s) for "<strong><%= studentSearch.query %></strong>"<%= studentSearch.totalMatches > studentSearch.results.length ? ` out of ${studentSearch.totalMatches} matches` : '' %>.</p>
            <table>
              <tr><th>Roll</th><th>Name</th><th>Phone</th><th>Email</th><th>Batch</th><th>Action</th></tr>
              <% studentSearch.results.forEach((student) => { %>
                <tr>
                  <td><%= student.roll_no %></td>
                  <td><%= student.name %></td>
                  <td><%= student.contact_phone || '-' %></td>
                  <td><%= student.email || '-' %></td>
                  <td><%= student.batch_name || '-' %></td>
                  <td><a href="/admin/students/<%= student.id %>/overview">Open Dashboard</a></td>
                </tr>
              <% }) %>
            </table>
          <% } else { %>
            <p class="muted">No student matched "<strong><%= studentSearch.query %></strong>". Try full roll number, name, or contact number.</p>
          <% } %>
        </section>
      <% } %>

      <section class="grid two">
        <div class="card">
          <h2>Add Student</h2>
          <p class="muted">If you leave password empty, the student logs in with roll number as password.</p>
          <% if (studentUsage.limit !== null) { %>
            <p class="muted">Current plan allows <strong><%= studentUsage.limit %></strong> students. Added: <strong><%= studentUsage.count %></strong>. Remaining: <strong><%= studentUsage.remaining %></strong>.</p>
          <% } %>
          <form method="post" action="/admin/students">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Roll Number</label>
            <input type="text" name="rollNo" required />

            <label>Name</label>
            <input type="text" name="name" />

            <label>Contact Number</label>
            <input type="text" name="contactPhone" placeholder="9876543210" />

            <label>Email ID</label>
            <input type="email" name="email" placeholder="student@example.com" />

            <label>Batch</label>
            <select name="batchId" required>
              <option value="">Select batch</option>
              <% batches.forEach((batch) => { %>
                <option value="<%= batch.id %>"><%= batch.name %></option>
              <% }) %>
            </select>

            <label>Password (optional, default = roll no)</label>
            <input type="text" name="password" />

            <button type="submit" class="btn" <%= batches.length ? '' : 'disabled' %>>Create Student</button>
          </form>
          <% if (!batches.length) { %>
            <p class="muted">Create at least one batch first. Then you can add students into it.</p>
          <% } %>
        </div>

        <div class="card">
          <h2>Batch Setup</h2>
          <form method="post" action="/admin/batches" data-single-submit>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Custom Batch Name</label>
            <input type="text" name="batchName" placeholder="11th-A, 11th-B, MHT-CET, Repeater Batch" required />
            <button type="submit" class="btn">Create Batch</button>
          </form>

          <form method="post" action="/admin/batches/rename" class="batch-rename-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <h3>Promote / Rename Batch</h3>
            <label>Current Batch</label>
            <select name="batchId" required>
              <option value="">Select batch</option>
              <% batches.forEach((batch) => { %>
                <option value="<%= batch.id %>"><%= batch.name %></option>
              <% }) %>
            </select>

            <label>New Batch Name</label>
            <input type="text" name="newBatchName" placeholder="12th-A, 12th-B, Repeater Batch, MHT-CET" required />
            <button type="submit" class="btn secondary">Update Batch</button>
          </form>

          <h3 style="margin-top: 20px;">Existing Batches</h3>
          <table>
            <tr><th>Batch</th><th>Status</th><th>Created</th><th>Completed</th><th>Count</th><th>Action</th></tr>
            <% batchSummaries.forEach((batch) => { %>
              <tr>
                <td><%= batch.name %></td>
                <td><%= batch.status || (batch.isUnassigned ? '-' : 'active') %></td>
                <td><%= batch.createdDaysAgo || '-' %></td>
                <td><%= batch.completedDaysAgo || '-' %></td>
                <td><%= batch.count %></td>
                <td>
                  <% if (batch.id && !batch.is_retention_batch) { %>
                    <% if (batch.status === 'completed') { %>
                      <form method="post" action="/admin/batches/<%= batch.id %>/activate" style="display:inline-block; margin-right: 8px;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn secondary compact">Make Active</button>
                      </form>
                    <% } else { %>
                      <form method="post" action="/admin/batches/<%= batch.id %>/complete" style="display:inline-block; margin-right: 8px;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                        <button type="submit" class="btn secondary compact">Mark Complete</button>
                      </form>
                    <% } %>
                    <form method="post" action="/admin/batches/<%= batch.id %>/delete" onsubmit="return confirm('Delete batch <%= batch.name %>? Students must be removed from this batch first. Related notes and answer windows for this batch will also be removed.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn danger compact">Delete Batch</button>
                    </form>
                  <% } else if (batch.is_retention_batch) { %>
                    <span class="muted">Protected retention batch</span>
                  <% } else { %>
                    <span class="muted">-</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </table>
          <p class="tiny-note">You can delete only an empty batch. Completed batches can keep up to 5 retained students for future admissions or parent references.</p>
        </div>
      </section>

      <section class="card">
        <h2>Completed Batch Retention</h2>
        <% if (!completedBatches.length) { %>
          <p class="muted">No completed batches yet.</p>
        <% } %>
        <% completedBatches.forEach((batch) => { %>
          <details class="batch-accordion">
            <summary class="batch-summary">
              <span class="batch-summary-title"><%= batch.name %></span>
              <span class="batch-summary-count"><%= batch.studentCount %> active records | retained <%= batch.retainedCount %>/<%= 5 %></span>
            </summary>
            <div class="batch-accordion-body">
              <p class="muted">Created <strong><%= batch.createdDaysAgo || '-' %></strong>. Completed <strong><%= batch.completedDaysAgo || '-' %></strong> ago. Keep only up to 5 students from this batch in retained records.</p>
              <% if (!batch.eligibleRetentionStudents.length) { %>
                <p class="muted">No eligible students left in this batch to move.</p>
              <% } else if (batch.retentionRemaining <= 0) { %>
                <p class="muted">Retention limit already reached for this batch.</p>
              <% } else { %>
                <table>
                  <tr><th>Roll</th><th>Name</th><th>Move To Retention</th></tr>
                  <% batch.eligibleRetentionStudents.forEach((student) => { %>
                    <tr>
                      <td><%= student.roll_no %></td>
                      <td><%= student.name %></td>
                      <td>
                        <form method="post" action="/admin/batches/<%= batch.id %>/retain-student">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <input type="hidden" name="studentId" value="<%= student.id %>" />
                          <button type="submit" class="btn compact" <%= batch.retentionRemaining <= 0 ? 'disabled' : '' %>>Move</button>
                        </form>
                      </td>
                    </tr>
                  <% }) %>
                </table>
              <% } %>
            </div>
          </details>
        <% }) %>
      </section>

      <section class="card">
        <h2>Students by Batch</h2>
        <p class="muted">Compact batch cards keep the page lighter. Open only the batch you want to work on.</p>
        <% if (!studentBatchGroups.length) { %>
          <p class="muted">No students available yet.</p>
        <% } %>
        <div class="batch-accordion-list">
          <% studentBatchGroups.forEach((group) => { %>
            <details class="batch-accordion batch-accordion--students">
              <summary class="batch-summary">
                <span class="batch-summary-title"><%= group.label %></span>
                <span class="batch-summary-count"><%= group.students.length %> students</span>
              </summary>
              <div class="batch-accordion-body">
                <div class="student-card-list">
                  <% group.students.forEach((s) => { %>
                    <article class="student-card-compact">
                      <div class="student-card-head">
                        <div>
                          <div class="student-roll-pill">#<%= s.roll_no %></div>
                          <h3><%= s.name %></h3>
                        </div>
                        <div class="student-contact-stack">
                          <span><%= s.contact_phone || 'No phone' %></span>
                          <span><%= s.email || 'No email' %></span>
                        </div>
                      </div>
                      <div class="student-card-actions">
                        <a href="/admin/students/<%= s.id %>/overview" class="mini-link">View Dashboard</a>
                        <form method="post" action="/admin/students/<%= s.id %>/reset-password" style="display:inline-block; margin-right: 8px;">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn secondary compact">Reset Password</button>
                        </form>
                        <form method="post" action="/admin/students/<%= s.id %>/delete" onsubmit="return confirm('Delete this student? All papers/attendance/fees will also be deleted.');">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                          <button type="submit" class="btn danger compact">Delete</button>
                        </form>
                      </div>
                    </article>
                  <% }) %>
                </div>
              </div>
            </details>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (!subscriptionState.accessBlocked && activeSection === 'attendance') { %>
      <section class="grid two">
        <div class="card">
          <h2>Mark Attendance</h2>
          <div class="tab-buttons" role="tablist">
            <button type="button" class="tab-btn active" data-tab="single">Single Student</button>
            <button type="button" class="tab-btn" data-tab="bulk">Bulk by Batch</button>
          </div>

          <div id="tab-single" class="tab-panel active">
            <form method="post" action="/admin/attendance">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label>Roll Number</label>
              <input type="text" name="rollNo" required />
              <label>Date</label>
              <input type="date" name="attendanceDate" required />
              <label>Status</label>
              <select name="status" required>
                <option value="present">Present</option>
                <option value="absent">Absent</option>
                <option value="late">Late</option>
              </select>
              <label>Notes</label>
              <input type="text" name="notes" />
              <button type="submit" class="btn">Save Attendance</button>
            </form>
          </div>

          <div id="tab-bulk" class="tab-panel">
            <form method="post" action="/admin/attendance-bulk">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <label>Batch</label>
              <select name="batchId" required>
                <option value="">Select batch</option>
                <% batches.forEach((batch) => { %>
                  <option value="<%= batch.id %>"><%= batch.name %></option>
                <% }) %>
              </select>

              <label>Date</label>
              <input type="date" name="attendanceDate" required />

              <label>Absent Roll Numbers (comma/new line/space)</label>
              <textarea name="absentRollNos" rows="3" placeholder="101, 105, 108"></textarea>

              <label>Notes (optional)</label>
              <input type="text" name="notes" placeholder="Special class note" />

              <button type="submit" class="btn">Mark Attendance (others present)</button>
            </form>
          </div>
        </div>

        <div class="card">
          <h2>Attendance By Date</h2>
          <form method="get" action="/admin/dashboard" class="inline-controls">
            <input type="hidden" name="section" value="attendance" />
            <label>Month</label>
            <input type="month" name="attendanceMonth" value="<%= attendanceMonthFilter %>" />
            <label>Date Filter</label>
            <select name="attendanceDate">
              <option value="">All Dates</option>
              <% attendanceDates.forEach((d) => { %>
                <option value="<%= d.attendance_date %>" <%= attendanceDateFilter === d.attendance_date ? 'selected' : '' %>><%= d.attendance_date %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn">Apply</button>
          </form>
          <a class="mini-link" href="/admin/dashboard?section=attendance">Clear Filter</a>
          <div class="hero-chip-row">
            <span class="info-chip">Attendance Entries <strong><%= attendanceThisMonthCount %></strong></span>
            <span class="info-chip">Month <strong><%= attendanceMonthFilter %></strong></span>
          </div>

          <% if (!Object.keys(attendanceByDate || {}).length) { %>
            <p class="muted">No attendance records found for selected date.</p>
          <% } %>
        </div>
      </section>

      <% Object.keys(attendanceByDate || {}).forEach((day) => { %>
        <section class="card">
          <h3>Attendance Date: <%= day %></h3>
          <table>
            <tr><th>Roll</th><th>Name</th><th>Batch</th><th>Status</th><th>Notes</th></tr>
            <% attendanceByDate[day].forEach((a) => { %>
              <tr>
                <td><%= a.roll_no %></td>
                <td><%= a.name %></td>
                <td><%= a.batch_name || ((a.standard || a.course) ? `${a.standard || ''}${a.standard && a.course ? ' - ' : ''}${a.course ? a.course.toUpperCase() : ''}` : '-') %></td>
                <td><span class="status <%= a.status %>"><%= a.status %></span></td>
                <td><%= a.notes || '-' %></td>
              </tr>
            <% }) %>
          </table>
        </section>
      <% }) %>
    <% } %>

    <% if (!subscriptionState.accessBlocked && activeSection === 'fees') { %>
      <section class="grid two">
        <div class="card">
          <h2>Add Fee Record</h2>
          <form method="post" action="/admin/fees">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Roll Number</label>
            <input type="text" name="rollNo" required />
            <label>Amount</label>
            <input type="number" name="amount" step="0.01" min="0" required />
            <label>Due Date</label>
            <input type="date" name="dueDate" />
            <label>Payment Date</label>
            <input type="date" name="paymentDate" />
            <label>Status</label>
            <select name="status" required>
              <option value="pending">Pending</option>
              <option value="paid">Paid</option>
              <option value="overdue">Overdue</option>
            </select>
            <label>Notes</label>
            <input type="text" name="notes" />
            <button type="submit" class="btn">Save Fee</button>
          </form>
        </div>

        <div class="card">
          <h2>Fee Records</h2>
          <form method="get" action="/admin/dashboard" class="inline-controls">
            <input type="hidden" name="section" value="fees" />
            <label>Month</label>
            <input type="month" name="feesMonth" value="<%= feesMonthFilter %>" />
            <button type="submit" class="btn">Apply</button>
            <a class="mini-link" href="/admin/dashboard?section=fees">Clear Filter</a>
          </form>
          <div class="hero-chip-row">
            <span class="info-chip">Paid This Month <strong><%= feesPaidThisMonth.length %></strong></span>
            <span class="info-chip">Month <strong><%= feesMonthFilter %></strong></span>
          </div>
          <table>
            <tr><th>Roll</th><th>Name</th><th>Batch</th><th>Amount</th><th>Due</th><th>Payment</th><th>Status</th><th>Notes</th></tr>
            <% fees.forEach((f) => { %>
              <tr>
                <td><%= f.roll_no %></td>
                <td><%= f.name %></td>
                <td><%= f.batch_name || ((f.standard || f.course) ? `${f.standard || ''}${f.standard && f.course ? ' - ' : ''}${f.course ? f.course.toUpperCase() : ''}` : '-') %></td>
                <td><%= f.amount %></td>
                <td><%= f.due_date || '-' %></td>
                <td><%= f.payment_date || '-' %></td>
                <td><span class="status <%= f.status %>"><%= f.status %></span></td>
                <td><%= f.notes || '-' %></td>
              </tr>
            <% }) %>
          </table>
        </div>
      </section>
    <% } %>

    <% if (!subscriptionState.accessBlocked && activeSection === 'papers') { %>
      <section class="grid two">
        <div class="card">
          <h2>Assign Paper to Student</h2>
          <p class="muted">Admins can upload a student paper directly. Optional marks update the progress chart immediately.</p>
          <form method="post" action="<%= appendCsrfToUrl('/admin/upload-paper-single') %>" enctype="multipart/form-data" data-single-submit>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Student Roll Number</label>
            <input type="text" name="rollNo" required />

            <label>Test Title</label>
            <input type="text" name="testLabel" placeholder="Weekly Chemistry Test" />

            <div class="grid two compact-grid">
              <div>
                <label>Marks Obtained</label>
                <input type="number" name="marksObtained" step="0.01" min="0" />
              </div>
              <div>
                <label>Max Marks</label>
                <input type="number" name="maxMarks" step="0.01" min="0" />
              </div>
            </div>

            <label>Link to Upload Window (optional)</label>
            <select name="answerRequestId">
              <option value="">General Paper</option>
              <% answerRequestSummaries.forEach((request) => { %>
                <option value="<%= request.id %>"><%= request.title %> | <%= request.batch_name || ((request.standard || request.course) ? `${request.standard || ''}${request.standard && request.course ? ' - ' : ''}${request.course ? request.course.toUpperCase() : ''}` : '-') %></option>
              <% }) %>
            </select>

            <label>Select File</label>
            <input type="file" name="paper" required />
            <button type="submit" class="btn">Upload for Student</button>
          </form>
        </div>

        <div class="card">
          <h2>Bulk Upload Test Papers</h2>
          <p class="muted">Filename rules:</p>
          <p class="muted"><code>101.pdf</code> (only assign paper)</p>
          <p class="muted"><code>101_78_100.pdf</code> (auto-save marks 78/100)</p>
          <p class="muted">Pattern: <code>rollno_marks_max.ext</code></p>
          <form method="post" action="<%= appendCsrfToUrl('/admin/upload-papers') %>" enctype="multipart/form-data" data-single-submit>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Select Files</label>
            <input type="file" name="papers" multiple required />
            <button type="submit" class="btn">Upload and Assign</button>
          </form>
        </div>
      </section>

      <section class="card">
        <h2>All Test Papers</h2>
        <form method="get" action="/admin/dashboard" class="inline-controls">
          <input type="hidden" name="section" value="papers" />
          <label>Month</label>
          <input type="month" name="papersMonth" value="<%= papersMonthFilter %>" />
          <button type="submit" class="btn">Apply</button>
          <a class="mini-link" href="/admin/dashboard?section=papers">Clear Filter</a>
        </form>
        <div class="hero-chip-row">
          <span class="info-chip">Papers This Month <strong><%= papersThisMonthCount %></strong></span>
          <span class="info-chip">Month <strong><%= papersMonthFilter %></strong></span>
        </div>
        <table>
          <tr><th>Roll</th><th>Name</th><th>Batch</th><th>Test</th><th>Type</th><th>Uploaded By</th><th>Marks</th><th>Upload Date</th><th>Actions</th></tr>
          <% papers.forEach((p) => { %>
            <tr>
              <td><%= p.roll_no %></td>
              <td><%= p.name %></td>
              <td><%= p.batch_name || ((p.standard || p.course) ? `${p.standard || ''}${p.standard && p.course ? ' - ' : ''}${p.course ? p.course.toUpperCase() : ''}` : '-') %></td>
              <td><%= p.test_label || p.original_name %></td>
              <td><%= p.paper_type === 'answer_submission' ? 'Answer Upload' : 'General' %></td>
              <td><%= p.uploaded_by_name || '-' %> (<%= p.uploaded_by_role || '-' %>)</td>
              <td>
                <% if (p.marks_obtained !== null && p.max_marks !== null) { %>
                  <%= p.marks_obtained %>/<%= p.max_marks %>
                <% } else { %>
                  -
                <% } %>
              </td>
              <td><%= p.upload_date %></td>
              <td>
                <a href="/papers/<%= p.id %>/view" target="_blank" rel="noopener">Open</a>
                <a href="/papers/<%= p.id %>/download">Download</a>
                <a href="/admin/papers/<%= p.id %>/debug" target="_blank" rel="noopener">Debug</a>
                <form method="post" action="/papers/<%= p.id %>/delete" style="display:inline-block" onsubmit="return confirm('Delete this paper?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="redirectTo" value="/admin/dashboard?section=papers" />
                  <button type="submit" class="btn danger compact">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </table>
      </section>
    <% } %>

    <% if (!subscriptionState.accessBlocked && activeSection === 'notes') { %>
      <section class="grid two">
        <div class="card">
          <h2>Add Batch Note / Video Link</h2>
          <form method="post" action="/admin/notes">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Batch</label>
            <select name="batchId" required>
              <option value="">Select batch</option>
              <% batches.forEach((batch) => { %>
                <option value="<%= batch.id %>"><%= batch.name %></option>
              <% }) %>
            </select>

            <label>Title</label>
            <input type="text" name="title" placeholder="Physics Revision Notes" required />

            <label>Resource URL (Google Drive / YouTube)</label>
            <input type="url" name="resourceUrl" placeholder="https://..." required />

            <label>Description (optional)</label>
            <textarea name="description" rows="3"></textarea>

            <button type="submit" class="btn">Publish for Batch</button>
          </form>
        </div>

        <div class="card">
          <h2>Published Batch Notes</h2>
          <table>
            <tr><th>Title</th><th>Batch</th><th>Link</th><th>Description</th><th>Date</th></tr>
            <% notes.forEach((n) => { %>
              <tr>
                <td><%= n.title %></td>
                <td><%= n.batch_name || ((n.standard || n.course) ? `${n.standard || ''}${n.standard && n.course ? ' - ' : ''}${n.course ? n.course.toUpperCase() : ''}` : '-') %></td>
                <td><a href="<%= n.resource_url %>" target="_blank" rel="noopener">Open Link</a></td>
                <td><%= n.description || '-' %></td>
                <td><%= n.created_at %></td>
              </tr>
            <% }) %>
          </table>
        </div>
      </section>
    <% } %>

    <% if (!subscriptionState.accessBlocked && activeSection === 'settings') { %>
      <section class="grid two">
        <div class="card">
          <h2>Profile & Branding</h2>
          <p class="muted">Update your admin display name and the portal branding your students see.</p>
          <form method="post" action="/admin/settings/profile">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Admin Display Name</label>
            <input type="text" name="adminDisplayName" value="<%= user.name || '' %>" required />

            <label>Admin Contact Number</label>
            <input type="text" name="adminContactPhone" value="<%= adminProfile?.contact_phone || user.contactPhone || '' %>" placeholder="9876543210" />

            <label>Admin Email</label>
            <input type="email" name="adminEmail" value="<%= adminProfile?.email || user.email || '' %>" placeholder="admin@class.com" />

            <label>Coaching Name</label>
            <input type="text" name="coachingName" value="<%= coaching?.name || '' %>" required />

            <label>Portal Display Name</label>
            <input type="text" name="brandName" value="<%= coaching?.brand_name || coaching?.name || '' %>" placeholder="Name shown on login and dashboards" />

            <label>Contact Email</label>
            <input type="email" name="contactEmail" value="<%= coaching?.contact_email || '' %>" placeholder="class@example.com" />

            <label>Logo URL</label>
            <input type="url" name="logoUrl" value="<%= coaching?.logo_url || '' %>" placeholder="https://example.com/logo.png" />

            <div class="branding-colors">
              <div>
                <label>Theme Primary</label>
                <input type="text" name="themePrimary" value="<%= coaching?.theme_primary || '#1769aa' %>" placeholder="#1769aa" />
              </div>
              <div>
                <label>Theme Background</label>
                <input type="text" name="themeBackground" value="<%= coaching?.theme_background || '#f3f6fb' %>" placeholder="#f3f6fb" />
              </div>
              <div>
                <label>Theme Surface</label>
                <input type="text" name="themeSurface" value="<%= coaching?.theme_surface || '#ffffff' %>" placeholder="#ffffff" />
              </div>
            </div>

            <button type="submit" class="btn">Save Settings</button>
          </form>
        </div>

        <div class="card">
          <h2>Update Password</h2>
          <p class="muted">Use your current password here. If this is still your temporary password, enter that as the current password first.</p>
          <form method="post" action="/admin/settings/password">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <label>Current Password</label>
            <input type="password" name="oldPassword" required />

            <label>New Password</label>
            <input type="password" name="newPassword" minlength="8" required />

            <label>Confirm New Password</label>
            <input type="password" name="confirmPassword" minlength="8" required />

            <button type="submit" class="btn">Change Password</button>
          </form>
        </div>
      </section>
    <% } %>
  </div>

  <script>
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');
    const trackerFilters = document.querySelectorAll('.tracker-filter');
    const singleSubmitForms = document.querySelectorAll('form[data-single-submit]');

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tab = btn.dataset.tab;
        tabButtons.forEach((b) => b.classList.remove('active'));
        tabPanels.forEach((p) => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById(`tab-${tab}`).classList.add('active');
      });
    });

    trackerFilters.forEach((select) => {
      select.addEventListener('change', () => {
        const trackerId = select.dataset.trackerId;
        const mode = select.value;
        document.querySelectorAll(`[data-tracker-panel="${trackerId}"]`).forEach((panel) => {
          panel.classList.toggle('active', panel.dataset.trackerMode === mode);
        });
      });
    });

    singleSubmitForms.forEach((form) => {
      form.addEventListener('submit', () => {
        const submitButtons = form.querySelectorAll('button[type="submit"]');
        submitButtons.forEach((button) => {
          button.disabled = true;
          if (!button.dataset.originalText) {
            button.dataset.originalText = button.textContent;
          }
          button.textContent = 'Saving...';
        });
      });
    });
  </script>
</body>
</html>
