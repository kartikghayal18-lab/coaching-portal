<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Admin Password - Coaching Portal</title>
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body style="<%= branding?.cssVars || '' %>">
  <div class="container small">
    <div class="card login-hero">
      <p class="eyebrow">Admin Recovery</p>
      <h1>Reset Password</h1>
      <p class="muted">Verification completed for <strong><%= resetRequest?.className || 'your coaching' %></strong>. First request OTP on email or contact number, then set your new password.</p>
    </div>

    <% if (flash) { %>
      <div class="alert <%= flash.type %>"><%= flash.text %></div>
    <% } %>

    <div class="grid two">
      <div class="card">
        <h2>Request OTP</h2>
        <p class="muted">Choose where the OTP should be delivered.</p>

        <form method="post" action="/admin/reset-password/send-otp">
          <input type="hidden" name="channel" value="email" />
          <button type="submit" class="btn" <%= otpChannels?.email?.available ? '' : 'disabled' %>>
            Send OTP to Email
          </button>
          <p class="tiny-note">
            <%= otpChannels?.email?.available ? (otpChannels.email.masked || 'Email available') : (otpChannels?.email?.reason || 'Email not available') %>
          </p>
        </form>

        <form method="post" action="/admin/reset-password/send-otp">
          <input type="hidden" name="channel" value="sms" />
          <button type="submit" class="btn secondary" <%= otpChannels?.sms?.available ? '' : 'disabled' %>>
            Send OTP to Contact
          </button>
          <p class="tiny-note">
            <%= otpChannels?.sms?.available ? (otpChannels.sms.masked || 'Contact available') : (otpChannels?.sms?.reason || 'Contact not available') %>
          </p>
        </form>

        <% if (otpState) { %>
          <div class="alert <%= otpState.expired ? 'error' : 'warning' %>">
            <% if (otpState.expired) { %>
              Last OTP expired. Request a new one.
            <% } else { %>
              OTP sent to <strong><%= otpState.destinationMasked %></strong>. It expires in <strong><%= otpState.remainingSeconds %>s</strong>.
            <% } %>
          </div>
        <% } %>
      </div>

      <form method="post" action="/admin/reset-password" class="card">
        <h2>Verify OTP & Set Password</h2>
        <label>OTP</label>
        <input type="text" name="otp" inputmode="numeric" maxlength="6" placeholder="6 digit OTP" required />

        <label>New Password</label>
        <input type="password" name="newPassword" minlength="6" required />

        <label>Confirm New Password</label>
        <input type="password" name="confirmPassword" minlength="6" required />

        <button type="submit" class="btn">Verify OTP and Reset Password</button>
        <a href="/login" class="mini-link">Back to Login</a>
      </form>
    </div>
  </div>
</body>
</html>
