<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= branding?.brandName || 'Demo Coaching' %> - Login</title>
  <link rel="icon" type="image/x-icon" href="<%= branding?.faviconUrl || '/branding/favicon.ico' %>" />
  <link rel="stylesheet" href="/public/styles.css" />
</head>
<body style="<%= branding?.cssVars || '' %>">
  <div class="container wide auth-page">
    <div class="auth-layout">
      <section class="card auth-panel auth-panel--hero login-hero">
        <div>
          <div class="brand-lockup">
            <% if (branding?.logoUrl) { %>
              <img src="<%= branding.logoUrl %>" alt="<%= branding.brandName %> logo" class="brand-logo" />
            <% } %>
            <div>
              <p class="eyebrow"><%= coaching ? (branding?.portalLabel || 'Coaching Portal') : (branding?.platformLabel || 'Coaching Platform') %></p>
              <h1><%= branding?.brandName || 'Demo Coaching' %></h1>
            </div>
          </div>

          <p class="muted auth-lead">
            <% if (coaching) { %>
              Sign in to <strong><%= coaching.name %></strong> with your coaching code and account details.
            <% } else { %>
              One portal for every coaching. Admins and students open only their own dashboard using the coaching code.
            <% } %>
          </p>

          <div class="hero-chip-row">
            <span class="info-chip">Multi Coaching SaaS</span>
            <span class="info-chip">Student Papers + Fees</span>
            <span class="info-chip">Attendance + Notes</span>
          </div>
        </div>

        <div class="feature-list">
          <article class="feature-item">
            <span class="feature-kicker">For Admin</span>
            <strong>Student list, papers, attendance, fees, answer upload windows, and class links in one place.</strong>
          </article>
          <article class="feature-item">
            <span class="feature-kicker">For Students</span>
            <strong>Open papers, check attendance, pending fees, notes, and progress without switching apps.</strong>
          </article>
          <article class="feature-item">
            <span class="feature-kicker">For Each Coaching</span>
            <strong>Separate login, separate data, separate branding, same website.</strong>
          </article>
        </div>
      </section>

      <div class="auth-column">
        <% if (flash) { %>
          <div class="alert <%= flash.type %>"><%= flash.text %></div>
        <% } %>

        <form method="post" action="/login" class="card auth-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <div class="form-title-row">
            <div>
              <p class="eyebrow">Sign In</p>
              <h2>Open Your Portal</h2>
            </div>
            <% if (coaching) { %>
              <span class="info-chip">Code: <strong><%= coaching.slug %></strong></span>
            <% } %>
          </div>

          <label>Login Type</label>
          <select name="role" id="role" required>
            <option value="admin">Coaching Admin</option>
            <option value="student">Student</option>
          </select>

          <div id="coachingField">
            <label>Coaching Code</label>
            <input
              type="text"
              id="coachingSlug"
              name="coachingSlug"
              value="<%= coachingHint || '' %>"
              placeholder="e.g. alpha-jee-academy"
              required
            />
            <% if (coaching) { %>
              <p class="muted">Opening portal for <strong><%= branding?.brandName || coaching.name %></strong> (<%= coaching.slug %>)</p>
            <% } %>
          </div>

          <label id="usernameLabel">Admin Username</label>
          <input type="text" id="usernameInput" name="username" placeholder="Enter username" required />

          <label id="passwordLabel">Password</label>
          <input type="password" id="passwordInput" name="password" required />
          <p id="passwordHelp" class="muted"></p>

          <label>Security Check: <%= captcha.prompt %> = ?</label>
          <input type="text" name="captchaAnswer" inputmode="numeric" placeholder="Enter answer" required />

          <button type="submit" class="btn">Login</button>
          <a href="/admin/forgot-password" class="mini-link">Forgot admin password?</a>
        </form>

        <section class="card trial-cta">
          <div class="form-title-row">
            <div>
              <p class="eyebrow">New Coaching</p>
              <h2>Need a Trial Portal?</h2>
            </div>
          </div>
          <p class="muted">Apply for a manual trial account. Share your coaching details and the owner can review and activate your portal.</p>
          <a href="/trial/apply" class="btn secondary">Apply for Trial</a>
        </section>
      </div>
    </div>
  </div>

  <script>
    const roleSelect = document.getElementById('role');
    const usernameLabel = document.getElementById('usernameLabel');
    const usernameInput = document.getElementById('usernameInput');
    const passwordLabel = document.getElementById('passwordLabel');
    const passwordInput = document.getElementById('passwordInput');
    const passwordHelp = document.getElementById('passwordHelp');

    function toggleLoginForm() {
      const role = roleSelect.value;

      if (role === 'admin') {
        usernameLabel.textContent = 'Admin Username';
        usernameInput.placeholder = 'Enter admin username';
        passwordLabel.textContent = 'Password';
        passwordInput.placeholder = 'Enter admin password';
        passwordInput.required = true;
        passwordHelp.textContent = '';
        return;
      }

      usernameLabel.textContent = 'Student Roll Number';
      usernameInput.placeholder = 'e.g. 101';
      passwordLabel.textContent = 'Password';
      passwordInput.placeholder = 'Leave blank to use roll number';
      passwordInput.required = false;
      passwordHelp.textContent = 'Default student password is the roll number unless the admin set a custom password.';
    }

    roleSelect.addEventListener('change', toggleLoginForm);
    toggleLoginForm();

    document.addEventListener('keydown', (event) => {
      const isOwnerShortcut = (event.ctrlKey || event.metaKey) && event.shiftKey && event.key.toLowerCase() === 'o';
      if (!isOwnerShortcut) return;

      event.preventDefault();
      window.location.href = '/owner/login';
    });
  </script>
</body>
</html>
