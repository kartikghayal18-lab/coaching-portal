# App
PORT=3000
SESSION_SECRET=change-this-session-secret
DATA_DIR=./data
LOCAL_PAPER_DIR=./papers

# Admin credentials (set your own before production)
ADMIN_USERNAME=Scc@coaching
ADMIN_PASSWORD=Scc@8208
# If true, admin username/password are reset on each startup.
# For production set it to false after first successful login.
ADMIN_FORCE_RESET=true

# Storage mode: local or s3
FILE_STORAGE_MODE=s3

# S3-compatible storage config
# AWS S3 example endpoint: https://s3.ap-south-1.amazonaws.com
# Cloudflare R2 example endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional: if you use a public CDN/base URL for files
S3_PUBLIC_BASE_URL=

# Signed URL validity seconds
S3_SIGNED_URL_TTL_SECONDS=600
